# =============================================================================
# imdapp control plane - environment configuration
# Copy to .env and fill in. NEVER commit the real .env.
# -----------------------------------------------------------------------------
# NOTE: .env is for *local* convenience only. Every compute task runs on
# GitHub Actions, so the authoritative copies of these values live in
# GitHub -> Settings -> Secrets and variables -> Actions.
# =============================================================================

# ---- GitHub ----
# PAT used by the reverse_lab_tools MCP server and by the GitHub MCP server.
# Required scopes: repo, workflow, read:org
GITHUB_PERSONAL_ACCESS_TOKEN=

# Owner/repo of the control plane (defaults are fine)
IMDAPP_REPO=jerryboganda/imdapp
IMDAPP_DEFAULT_BRANCH=main

# ---- Component (open-reverselab) ----
# Path to the vendored submodule, relative to the repo root.
REVERSELAB_DIR=open-reverselab

# ---- Optional: JSHook integration (inherited from open-reverselab) ----
JSHOOK_OPENAI_API_KEY=
JSHOOK_OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
JSHOOK_MODE=external-controller

# ---- Optional: CD deploy target (site) ----
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
