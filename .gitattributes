# Normalize line endings.
# Shell scripts MUST stay LF or they fail on Linux/macOS runners
# ("bad interpreter: /bin/bash^M").
* text=auto

*.sh    text eol=lf
*.bash  text eol=lf
Makefile text eol=lf

*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.py    text eol=lf

# Binary
*.png binary
*.jpg binary
*.gif binary
*.zip binary
*.exe binary
